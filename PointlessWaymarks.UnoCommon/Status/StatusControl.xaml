<UserControl
    x:Class="PointlessWaymarks.UnoCommon.Status.StatusControl"
    x:Name="StatusControlXaml"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:status="using:PointlessWaymarks.UnoCommon.Status"
    xmlns:appToast="using:PointlessWaymarks.UnoCommon.AppToast"
    xmlns:utility="using:PointlessWaymarks.UnoCommon.Utility"
    mc:Ignorable="d">
    <UserControl.Resources>
        <utility:BooleanToVisibilityConverter x:Key="BooleanToVisibility" />
    </UserControl.Resources>
    <Grid
        x:Name="MainGrid"
        HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch">
        <Rectangle
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            Fill="LightGray"
            Opacity="0.4"
            Visibility="{Binding BlockUi, Converter={StaticResource BooleanToVisibility}}" />
        <Border
            Margin="24"
            MaxWidth="800"
            MaxHeight="500"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Background="White"
            BorderBrush="Green"
            BorderThickness="2"
            CornerRadius="8"
            Padding="16"
            Visibility="{Binding BlockUi, Converter={StaticResource BooleanToVisibility}}">
            <Grid RowDefinitions="Auto,*">
                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
                    <ProgressRing IsActive="True" Width="20" Height="20" />
                    <TextBlock Text="Operation in progress..." FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
                <ListView
                    Grid.Row="1"
                    x:Name="StatusLogListView"
                    ItemsSource="{Binding StatusLog}"
                    Background="Transparent"
                    BorderThickness="0"
                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,2" />
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>

        <Grid
            x:Name="TextBoxGrid"
            Visibility="{Binding StringEntryVisible, Converter={StaticResource BooleanToVisibility}}"
            Background="#40000000"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch">
            <Border
                MaxWidth="600"
                Margin="24"
                Padding="24"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="White"
                BorderBrush="#CCCCCC"
                BorderThickness="1"
                CornerRadius="8">
                <StackPanel Spacing="16">
                    <TextBlock
                        Text="{Binding StringEntryTitle}"
                        FontSize="20"
                        FontWeight="Bold"
                        TextWrapping="Wrap"
                        HorizontalAlignment="Center" />
                    <TextBlock
                        Text="{Binding StringEntryMessage}"
                        TextWrapping="Wrap"
                        HorizontalAlignment="Center" />
                    <TextBox
                        x:Name="UserTextTextBox"
                        Text="{Binding StringEntryUserText, Mode=TwoWay}"
                        HorizontalAlignment="Stretch" />
                    <Grid ColumnDefinitions="*,*">
                        <Button
                            Grid.Column="0"
                            Margin="0,0,8,0"
                            HorizontalAlignment="Stretch"
                            Command="{Binding UserStringEntryCancelledResponseCommand}"
                            Content="Cancel" />
                        <Button
                            Grid.Column="1"
                            Margin="8,0,0,0"
                            HorizontalAlignment="Stretch"
                            Command="{Binding UserStringEntryApprovedResponseCommand}"
                            Content="Submit" />
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <ItemsControl
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            Margin="0,0,0,24"
            Visibility="{Binding ShowCancellations, Converter={StaticResource BooleanToVisibility}}"
            ItemsSource="{Binding CancellationList}">
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="status:UserCancellations">
                    <Button
                        Margin="4"
                        Command="{Binding Cancel}"
                        IsEnabled="{Binding IsEnabled}">
                        <TextBlock Margin="16,4" Text="{Binding Description}" />
                    </Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Grid
            Visibility="{Binding MessageBoxVisible, Converter={StaticResource BooleanToVisibility}}"
            Background="#40000000"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch">
            <Border
                MaxWidth="700"
                MaxHeight="600"
                Margin="24"
                Padding="24"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="White"
                BorderBrush="#CCCCCC"
                BorderThickness="1"
                CornerRadius="8">
                <Grid RowDefinitions="Auto,*,Auto">
                    <TextBlock
                        Grid.Row="0"
                        Text="{Binding MessageBoxTitle}"
                        FontSize="20"
                        FontWeight="Bold"
                        TextWrapping="Wrap"
                        HorizontalAlignment="Center"
                        Margin="0,0,0,16" />
                    <ScrollViewer
                        Grid.Row="1"
                        MaxHeight="400"
                        Margin="0,0,0,16"
                        VerticalScrollBarVisibility="Auto"
                        HorizontalScrollBarVisibility="Disabled">
                        <TextBlock
                            Text="{Binding MessageBoxMessage}"
                            TextWrapping="Wrap"
                            IsTextSelectionEnabled="True" />
                    </ScrollViewer>
                    <ItemsControl
                        Grid.Row="2"
                        x:Name="MessageBoxButtonsControl"
                        ItemsSource="{Binding MessageBoxButtonList}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="status:StatusControlMessageButton">
                                <Button
                                    Content="{Binding MessageText}"
                                    Click="OnMessageBoxButtonClick"
                                    Tag="{Binding MessageText}"
                                    MinWidth="80"
                                    Height="36" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Border>
        </Grid>

        <StackPanel
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Margin="16"
            Spacing="8"
            Orientation="Vertical">
            <ProgressRing
                IsActive="{Binding NonBlockingTaskAreRunning}"
                Visibility="{Binding NonBlockingTaskAreRunning, Converter={StaticResource BooleanToVisibility}}"
                Width="24"
                Height="24"
                HorizontalAlignment="Right" />
            <appToast:AppToastControl
                Width="320"
                DataContext="{Binding Toast}"
                HorizontalAlignment="Right" />
        </StackPanel>
    </Grid>
</UserControl>
