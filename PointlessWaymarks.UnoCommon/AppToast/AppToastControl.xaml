<UserControl
    x:Class="PointlessWaymarks.UnoCommon.AppToast.AppToastControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:appToast="using:PointlessWaymarks.UnoCommon.AppToast"
    mc:Ignorable="d">
    <UserControl.Resources>
        <appToast:AppToastTypeToForegroundColorConverter x:Key="AppToastTypeToForegroundColor" />
        <appToast:AppToastTypeToBackgroundColorConverter x:Key="AppToastTypeToBackgroundColor" />
    </UserControl.Resources>
    <ListView
        x:Name="ToastListView"
        ItemsSource="{Binding Items}"
        Background="Transparent"
        BorderThickness="0"
        SelectionMode="None">
        <ListView.ItemContainerStyle>
            <Style TargetType="ListViewItem">
                <Setter Property="Padding" Value="2" />
                <Setter Property="Margin" Value="0,2" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            </Style>
        </ListView.ItemContainerStyle>
        <ListView.ItemTemplate>
            <DataTemplate x:DataType="appToast:AppToastMessage">
                <Border
                    Background="{Binding MessageType, Converter={StaticResource AppToastTypeToBackgroundColor}}"
                    CornerRadius="4"
                    Padding="8,6">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock
                            Grid.Column="0"
                            Text="{Binding Message}"
                            Foreground="{Binding MessageType, Converter={StaticResource AppToastTypeToForegroundColor}}"
                            TextWrapping="Wrap"
                            VerticalAlignment="Center"
                            Margin="0,0,8,0" />
                        <Button
                            Grid.Column="1"
                            Click="OnCloseToastClick"
                            Tag="{Binding}"
                            VerticalAlignment="Top"
                            HorizontalAlignment="Right"
                            Padding="4,2"
                            Background="Transparent"
                            BorderThickness="0">
                            <FontIcon Glyph="&#xE711;" FontSize="12" Foreground="{Binding MessageType, Converter={StaticResource AppToastTypeToForegroundColor}}" />
                        </Button>
                    </Grid>
                </Border>
            </DataTemplate>
        </ListView.ItemTemplate>
    </ListView>
</UserControl>
